# サイト
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase（未設定ならサンプルデータで動きます）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 日次タスク（Vercel Cron が Authorization: Bearer で送る値）
CRON_SECRET=ランダムな長い文字列

# 医院リサーチ・記事・メルマガ本文の生成
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_MAPS_API_KEY=...          # Places API (New) を有効にしたキー
AUTO_PUBLISH_ARTICLES=false      # true にすると表現チェックを通った記事は自動公開

# メール（Resend）
RESEND_API_KEY=re_...
MAIL_FROM="自費歯科ナビ <news@your-domain.jp>"
MAIL_SENDER_INFO="運営：〇〇株式会社　東京都〇〇区〇〇 1-2-3　info@your-domain.jp"

# PR枠（Stripe）
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SPONSOR_PAYMENT_LINK=https://buy.stripe.com/xxxx
NEXT_PUBLIC_SPONSOR_PRICE_LABEL="月額 30,000円（税込）"

# オンライン相談（医院への送客・1件ごとの課金）
ADMIN_EMAIL=you@your-domain.jp   # 医院からの申込み通知の送り先

# テスト公開（需要検証）モード：医院はサンプル表示、相談は医院に送らず記録だけ
NEXT_PUBLIC_DEMO_MODE=true

# 本番の公開設定（DEMO_MODE を外したとき）
NEXT_PUBLIC_SITE_LAUNCHED=false     # true にするまで検索エンジンに載せない（noindex + robots.txt で拒否）
NEXT_PUBLIC_CONSULT_ENABLED=false   # 提携医院がそろうまでオンライン相談の入口を隠す
CLINIC_AUTO_PUBLISH=true            # false にすると自動で見つけた医院を全件「非公開」で登録する
